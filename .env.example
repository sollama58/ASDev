# ===========================================
# ASDF Token Launcher - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Solana Network ---
# Options: mainnet, devnet
SOLANA_NETWORK=mainnet

# Optional: Override RPC URL directly
# RPC_URL=https://your-custom-rpc.com

# Optional: Helius API key for better RPC on mainnet
# HELIUS_API_KEY=your-helius-api-key

# --- Wallet ---
# Base58-encoded private key for deployment wallet
DEV_WALLET_PRIVATE_KEY=your-base58-private-key

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- Vanity Grinder (ASDF addresses) ---
VANITY_GRINDER_ENABLED=true
VANITY_GRINDER_URL=http://localhost:8080
VANITY_GRINDER_API_KEY=your-grinder-api-key

# --- Pinata (IPFS) ---
# Required for metadata upload
PINATA_JWT=your-pinata-jwt
# Or use legacy API keys:
# API_KEY=your-pinata-api-key
# SECRET_KEY=your-pinata-secret-key

# --- Twitter Integration (Optional) ---
# TWITTER_API_KEY=your-twitter-api-key
# TWITTER_API_SECRET=your-twitter-api-secret
# TWITTER_ACCESS_TOKEN=your-twitter-access-token
# TWITTER_ACCESS_SECRET=your-twitter-access-secret

# --- PAGS (Pay-to-Twitter/X) ---
# Public key of the PAGS payout wallet (holds fees until claimed)
# PAGS_WALLET=your-pags-wallet-pubkey
# Base58 private key for signing claim transactions
# PAGS_WALLET_PRIVATE_KEY=your-pags-wallet-private-key
# Minimum SOL required to claim (default: 0.01)
# PAGS_MIN_CLAIM_SOL=0.01

# --- OAuth / Frontend URLs ---
# Backend API URL (used for building OAuth callback URLs)
# Example: https://asdev-1kvy.onrender.com
# BASE_URL=https://your-backend.onrender.com
# Frontend URL (where users are redirected after OAuth login)
# Example: https://alonisthe.dev/robinhood
# FRONTEND_URL=https://alonisthe.dev/robinhood
# Twitter OAuth2 callback URL (must be registered in Twitter Developer Portal)
# Example: https://asdev-1kvy.onrender.com/api/auth/twitter/callback
# TWITTER_OAUTH_CALLBACK_URL=/api/auth/twitter/callback
# Twitter OAuth2 credentials (for PAGS login)
# TWITTER_OAUTH2_CLIENT_ID=your-oauth2-client-id
# TWITTER_OAUTH2_CLIENT_SECRET=your-oauth2-client-secret
# PAGS_SESSION_SECRET=your-long-random-session-secret

# --- Content Moderation (Optional) ---
# CLARIFAI_API_KEY=your-clarifai-api-key

# --- Security ---
# Comma-separated list of allowed CORS origins (* = allow all)
CORS_ORIGINS=*

# API key for admin/debug endpoints (required in production)
# ADMIN_API_KEY=your-secure-admin-key

# --- UI Customization (Optional) ---
# HEADER_IMAGE_URL=https://your-logo-url.com/logo.png

# --- Storage (Optional) ---
# DISK_ROOT=./data

# --- Update Intervals (Optional, in milliseconds) ---
# HOLDER_UPDATE_INTERVAL=120000
# METADATA_UPDATE_INTERVAL=60000

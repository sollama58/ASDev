# ===========================================
# ShitPad - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Solana Network ---
# Options: mainnet, devnet
SOLANA_NETWORK=mainnet

# Optional: Override RPC URL directly
# RPC_URL=https://your-custom-rpc.com

# Optional: Helius API key for better RPC on mainnet
# HELIUS_API_KEY=your-helius-api-key

# --- Wallet ---
# Base58-encoded private key for deployment wallet
DEV_WALLET_PRIVATE_KEY=your-base58-private-key

# --- Fee Split ---
# Every claimed creator fee is split 50% to the token's own holders, 25% to the
# cross-token central pool, and 25% to the platform (24.5% buyback/burn + 0.5% upkeep).
# Destination for the buyback/burn share. If unset, it falls back to the existing
# platform fee wallet, so leaving this blank never redirects funds to a new address.
# BUYBACK_BURN_WALLET=your-buyback-burn-wallet-address

# --- Vanity Mint Grinder ---
# Pre-grinds mint keypairs so launched tokens get a contract address ending in "shit".
# The grinder runs as its own Render service (SERVER_MODE=grinder, src/grinder.js); the API
# and worker processes never grind, they only consume the pool and fall back to a random
# mint whenever it is empty. A launch is never blocked by the grinder being down.
#
# REQUIRED on both the grinder AND the API service, and it must be the SAME value: the
# grinder encrypts each mint seed with it, the API decrypts on claim. If they differ, the
# API cannot read the pool and every launch silently uses a random mint.
# VANITY_ENCRYPTION_KEY=generate-a-long-random-string

# Master switch. Only the grinder service needs this set to true.
# VANITY_GRINDER_ENABLED=true

# Pool depth: grinding stops at TARGET and restarts at LOW_WATER.
# VANITY_POOL_TARGET=50
# VANITY_POOL_LOW_WATER=40

# Suffix matching. Case-insensitive accepts all 8 capitalisations of "shit" that base58 can
# represent (the alphabet has no uppercase I and no lowercase l), which is ~8x less work per
# address than exact lowercase. Any suffix up to 8 characters works, but each extra
# character multiplies the work per address by 58.
# VANITY_SUFFIX=shit
# VANITY_CASE_INSENSITIVE=true

# Worker threads; defaults to every core on the grinder instance.
# VANITY_GRINDER_THREADS=4
# Fraction of wall-clock spent grinding, 1 = flat out. Lower only if sharing an instance.
# VANITY_DUTY_CYCLE=1

# --- Launch path (v29.1) ---
# Anti-bundling decoys launched before each real token. Each decoy is a full create plus buy,
# and the account rent a create allocates is NOT recovered by the sell that follows, so this
# is a real cost per launch against a 0.02 SOL deployment fee. Measure it on mainnet before
# raising it. ANTI_BUNDLE_MAX=0 disables decoys entirely.
# ANTI_BUNDLE_MIN=1
# ANTI_BUNDLE_MAX=5

# How old a payment may be and still be redeemable for a launch, in seconds.
# PAYMENT_MAX_AGE_SECONDS=3600

# Hosts a token's metadata URI may point at, comma separated. /api/deploy rejects anything
# else rather than writing it into the mint instruction.
# METADATA_URI_ALLOWED_HOSTS=gateway.pinata.cloud,ipfs.io,cloudflare-ipfs.com
# METADATA_URI_MAX_LENGTH=200

# A token's pending pool must reach this before it pays its holders. Read by the distributor,
# the admin simulator and /api/health alike.
# TOKEN_AIRDROP_THRESHOLD_SOL=1.0

# How long a vanity address may sit claimed before it is treated as stranded by a crashed
# launch and returned to the pool. Must exceed the longest realistic launch.
# VANITY_CLAIM_TIMEOUT_MS=900000

# --- PostgreSQL ---
# Required — the server will not start without a working connection string
DATABASE_URL=postgres://user:password@host:5432/database

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- Pinata (IPFS) ---
# Required for metadata upload
PINATA_JWT=your-pinata-jwt

# --- Twitter Integration (Optional) ---
# OAuth 1.0a app credentials (these are the names src/services/twitter.js reads)
# TWITTER_APP_KEY=your-twitter-app-key
# TWITTER_APP_SECRET=your-twitter-app-secret
# TWITTER_ACCESS_TOKEN=your-twitter-access-token
# TWITTER_ACCESS_SECRET=your-twitter-access-secret

# --- Public URLs ---
# Backend API URL, no trailing slash
# BASE_URL=https://your-backend.onrender.com
# Where the ShitPad site is served from
# FRONTEND_URL=https://your-shitpad-site.onrender.com

# --- AI-selected "King of the Hill" (Optional) ---
# ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Security ---
# Comma-separated list of allowed CORS origins (* = allow all)
CORS_ORIGINS=*

# API key for admin/debug endpoints (required in production)
# ADMIN_API_KEY=your-secure-admin-key

# --- UI Customization (Optional) ---
# HEADER_IMAGE_URL=https://your-logo-url.com/logo.png

# --- Storage (Optional) ---
# DISK_ROOT=./data

# --- Update Intervals (Optional, in milliseconds) ---
# HOLDER_UPDATE_INTERVAL=120000
